# =============================================================================
# WebAR Spatial Anchor — environment variables
#
# Copy to `.env` (git-ignored) and fill in what you need. EVERYTHING here is
# optional: with no .env at all the app runs with the bundled marker, the offline
# model index and the PeerJS public cloud for rooms.
# =============================================================================

# --- Feature flags (V2 modules) ---------------------------------------------
# Each module is lazy-loaded, so disabling one removes it from the graph entirely.
VITE_FEATURE_HANDS=true
VITE_FEATURE_ROOMS=true
VITE_FEATURE_SEARCH=true
# Optional ~30 MB multilingual embedding model for smart matching.
VITE_FEATURE_SEMANTIC=false
VITE_FEATURE_VOICE=true
VITE_FEATURE_PWA=true

# --- Image tracking (MindAR) -------------------------------------------------
# Path (relative to the site root) of the compiled target.
VITE_TARGET_SRC=targets.mind
# Pose filter: lower minCutOff = steadier but laggier; higher beta = snappier.
VITE_FILTER_MIN_CF=0.001
VITE_FILTER_BETA=0.01

# --- Shared rooms (PeerJS) ---------------------------------------------------
# Leave blank to use the free PeerJS public cloud.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
VITE_PEER_KEY=peerjs

# Optional free TURN relay (Open Relay / Metered free tier). Without it, users
# behind strict NAT / symmetric CGNAT mobile networks may not connect.
# VITE_TURN_URL=turn:relay.example.com:3478
# VITE_TURN_USER=
# VITE_TURN_CREDENTIAL=

# --- Model search proxy ------------------------------------------------------
# Leave as /api for the bundled Cloudflare Pages Functions.
VITE_SEARCH_PROXY=/api

# --- MediaPipe (hands mode) --------------------------------------------------
# The self-hosted files in public/mediapipe are always preferred (offline/PWA).
# These are the CDN fallbacks used only when they are absent — for instance on a
# deploy pruned to fit a 10 MiB upload cap, where the ~40 MB of wasm is dropped.
VITE_MEDIAPIPE_CDN=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.35/wasm
VITE_MEDIAPIPE_MODEL_CDN=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task

# --- Build -------------------------------------------------------------------
# Set by the GitHub Pages workflow; keep './' for Netlify/Cloudflare Pages.
# BASE_PATH=/

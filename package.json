{
  "name": "webar-spatial-anchor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "WebAR Spatial 3D Anchor & Canvas - zero-install marker + hand tracking AR studio.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:assets": "node scripts/copy-mediapipe.mjs && node scripts/copy-decoders.mjs && node scripts/gen-marker.mjs && node scripts/gen-icons.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "prune:deploy": "node scripts/prune-deploy.mjs",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:marker": "node scripts/gen-marker.mjs",
    "gen:target": "node scripts/gen-target.mjs",
    "copy:mediapipe": "node scripts/copy-mediapipe.mjs",
    "copy:decoders": "node scripts/copy-decoders.mjs",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.0.19",
    "@fontsource/inter": "^5.0.20",
    "@mediapipe/tasks-vision": "^0.10.14",
    "fuse.js": "^7.0.0",
    "lucide": "^0.446.0",
    "meshoptimizer": "^0.21.0",
    "mind-ar": "^1.2.5",
    "peerjs": "^1.5.4",
    "qrcode-generator": "^1.4.4",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^20.16.10",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "canvas": "^3.1.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
